---
import Logo from "@/components/Logo.astro";
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="#top" class="shrink-0 transition-opacity hover:opacity-80" aria-label="RivalFit — inicio">
      <Logo />
    </a>

    <a
      href="#descargar"
      class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full bg-primary px-6 font-sans text-[0.8rem] font-semibold tracking-wide text-primary-foreground shadow-md transition-all hover:scale-105 hover:bg-bone-muted"
    >
      Descargar
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M8 2v9m0 0l-3.5-3.5M8 11l3.5-3.5M2.5 14h11"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>
</header>