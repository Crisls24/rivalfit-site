---
import Logo from "@/components/Logo.astro";
---

<div class="fixed inset-x-0 top-0 z-[60] h-[3px] bg-volt/0" aria-hidden="true">
  <span id="scroll-progress" class="block h-full w-0 bg-volt transition-[width] duration-150 ease-out"></span>
</div>

<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-border bg-background/80 backdrop-blur-xl">
    <div class="mx-auto flex h-16 w-full max-w-[64rem] items-center justify-between gap-4 px-3 sm:px-6">
    <a href="#top" class="shrink-0 transition-opacity hover:opacity-80" aria-label="RivalFit — inicio">
      <Logo />
    </a>

    <button
      id="theme-toggle"
      type="button"
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-2 border-[#D8D2C4] bg-[#faf9f5] text-bone shadow-sm transition-all hover:scale-105 hover:border-volt hover:text-volt-ink dark:border-[#3A3B33] dark:bg-surface dark:text-bone-muted dark:hover:border-volt dark:hover:text-volt"
      aria-label="Cambiar modo claro u oscuro"
    >
      <!-- Sol: se muestra cuando el modo oscuro está activo -->
      <svg
        id="icon-sun"
        class="hidden dark:block"
        width="18"
        height="18"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="8" cy="8" r="3.4" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M8 1.4v1.8M8 12.8v1.8M1.4 8h1.8M12.8 8h1.8M3.3 3.3l1.3 1.3M11.4 11.4l1.3 1.3M12.7 3.3l-1.3 1.3M4.6 11.4l-1.3 1.3"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
      <!-- Luna: se muestra en modo claro -->
      <svg id="icon-moon" class="block dark:hidden" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M13.4 9.8A5.6 5.6 0 0 1 6.2 2.6a5.6 5.6 0 1 0 7.2 7.2Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const el = document.documentElement;
    const dark = el.classList.toggle("dark");
    el.style.colorScheme = dark ? "dark" : "light";
    try {
      localStorage.setItem("rivalfit-theme", dark ? "dark" : "light");
    } catch (e) {}
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", dark ? "#141510" : "#F3F1EB");

    const prefersReduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReduce) {
      const rect = btn.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dist = Math.hypot(
        Math.max(cx, window.innerWidth - cx),
        Math.max(cy, window.innerHeight - cy),
      );
      const size = dist * 2;
      const ring = document.createElement("span");
      ring.className = "rf-theme-ring";
      ring.style.left = `${cx - size / 2}px`;
      ring.style.top = `${cy - size / 2}px`;
      ring.style.width = `${size}px`;
      ring.style.height = `${size}px`;
      ring.style.background = dark ? "#141510" : "#F3F1EB";
      document.body.appendChild(ring);
      ring.addEventListener("animationend", () => ring.remove());
    }

    el.classList.add("theme-transition");
    window.setTimeout(() => el.classList.remove("theme-transition"), 340);
  });
</script>