---
const checks = [
  {
    title: "Valida al instante, mientras entrenas",
    body: "La IA reconoce el movimiento en tu teléfono y marca cada repetición en el momento.",
  },
  {
    title: "Solo suma lo correcto",
    body: "La técnica importa: lo que se hace a medias, no cuenta. Compites con criterio.",
  },
  {
    title: "Privado y sin rodeos",
    body: "Todo corre en tu móvil: sin subir vídeos, sin esperar a nadie.",
  },
] as const;
---

<!-- ═══ VALIDACIÓN CON IA ═══ -->
<section id="anti-trampas" class="border-t border-line bg-[#f7f5f0] dark:bg-[#171812]">
  <div class="container-site grid gap-10 py-16 sm:py-20 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
    <div data-reveal>
      <p class="mb-3 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-bone-faint">
        Inteligencia · Anti-trampas
      </p>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Cada repetición, validada con IA.
      </h2>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-bone-muted">
        RivalFit usa visión por computadora para validar cada repetición, todo dentro de tu teléfono.
      </p>

      <ul class="mt-6 space-y-4">
        {
          checks.map((check, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="flex gap-4">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-volt/15 shadow-[0_0_12px_rgba(164,238,0,0.12)] dark:bg-volt">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="text-volt-ink dark:hidden" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="hidden text-volt-ink dark:block" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <h3 class="font-sans text-lg font-semibold tracking-wide text-bone">{check.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-bone-muted">{check.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div data-reveal style="--reveal-delay:160ms" class="mx-auto w-full max-w-[23rem] lg:mt-0">
      <div class="overflow-hidden rounded-[2rem] border border-[#e5dfd4] bg-[#faf9f5] shadow-[0_20px_42px_rgba(17,19,17,0.05)] dark:border-[#2B2C25] dark:bg-[#1B1C17]">
        <div class="relative aspect-[4/5] overflow-hidden bg-[#16161a]">
          <video
            class="absolute inset-0 h-full w-full object-cover object-center"
            src="/assets/videos/197848-905691449_medium.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Repetición validada con IA por RivalFit"
          ></video>

          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#111311]/45 via-transparent to-transparent"></div>

          <span class="rf-scan" aria-hidden="true"></span>

          <div class="absolute bottom-4 left-4 flex items-center gap-2 rounded-full border border-white/15 bg-[#111311]/30 px-3 py-1.5 backdrop-blur-sm">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-volt font-sans text-[0.7rem] font-bold text-volt-ink">✓</span>
            <span class="font-sans text-[0.56rem] font-semibold uppercase tracking-[0.2em] text-white/85">Validada · IA</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>