---
import { APP } from "@/lib/site";

const steps = [
  { n: "1", title: "Descarga la APK" },
  { n: "2", title: "Permite fuentes desconocidas" },
  { n: "3", title: "Abre RivalFit y empieza" },
] as const;

const perks = [
  "Liga privada",
  "Repeticiones validadas con IA",
  "Ranking semanal",
  "Beta gratis",
] as const;
---

<!-- ═══ DESCARGA ═══ -->
<section id="descargar" class="border-t border-line bg-[#f7f5f0] dark:bg-[#171812]">
  <div class="container-site pt-16 pb-12 sm:pt-20 sm:pb-14">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-4 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-bone-faint">
        Empieza a competir
      </p>
      <h2 class="font-display text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Descarga la beta de RivalFit para Android.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-bone-muted sm:text-lg">
        La beta de RivalFit para Android, lista en tres pasos.
      </p>

      <div class="mt-9">
        <a
          href={APP.apkLatestPath}
          data-magnet
          class="rf-magnet relative inline-flex h-14 items-center justify-center gap-3 overflow-hidden rounded-full bg-volt px-10 font-sans text-[0.95rem] font-bold tracking-wide text-volt-ink shadow-[0_12px_30px_rgba(164,238,0,0.22)] transition-all hover:-translate-y-1 hover:shadow-[0_18px_32px_rgba(164,238,0,0.18)]"
        >
          <span class="rf-shine" aria-hidden="true"></span>
          <span class="relative flex items-center gap-3">
            <span class="rf-ripple pointer-events-none absolute -inset-3 rounded-full bg-volt/40"></span>
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" class="rf-arrow-bob" aria-hidden="true">
              <path
                d="M8 2v9m0 0l-3.5-3.5M8 11l3.5-3.5M2.5 14h11"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            Descargar RivalFit
          </span>
        </a>
      </div>
    </div>

    <ol data-draw class="mx-auto mt-14 flex w-full max-w-2xl items-start">
      {steps.map((step, i) => (
        <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="flex min-w-0 flex-1 flex-col items-center">
          <div class="flex w-full items-center">
            <span
              data-connector
              style={`--rd:${i * 90}ms`}
              class={`rf-connector h-0.5 flex-1 rounded-full ${i === 0 ? "bg-transparent" : "bg-[#D8D2C4] dark:bg-[#2C2D26]"}`}
              aria-hidden="true"
            ></span>
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-volt font-mono text-base font-bold text-volt-ink shadow-[0_6px_14px_rgba(164,238,0,0.35)]"
            >
              {step.n}
            </span>
            <span
              data-connector
              style={`--rd:${(steps.length - 1 - i) * 90}ms`}
              class={`rf-connector h-0.5 flex-1 rounded-full ${i === steps.length - 1 ? "bg-transparent" : "bg-[#D8D2C4] dark:bg-[#2C2D26]"}`}
              aria-hidden="true"
            ></span>
          </div>
          <p class="mt-3.5 max-w-[9.5rem] text-center text-[0.82rem] font-semibold leading-snug text-bone">
            {step.title}
          </p>
        </li>
      ))}
    </ol>

    <ul
      data-reveal
      style="--reveal-delay:240ms"
      class="mt-12 flex flex-wrap items-center justify-center gap-2"
    >
      {
        perks.map((perk) => (
          <li class="flex items-center gap-2 rounded-full border border-[#dfe5d3] bg-[#f8f6f1] px-3.5 py-1.5 dark:border-[#2B2C25] dark:bg-[#1B1C17]">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-volt">
              <svg width="11" height="11" viewBox="0 0 16 16" fill="none" class="text-volt-ink" aria-hidden="true">
                <path d="M8 1.5l5 2v4.2c0 3-2.1 5.3-5 6.8-2.9-1.5-5-3.8-5-6.8V3.5l5-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-[0.78rem] font-medium tracking-wide text-bone-muted">{perk}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>