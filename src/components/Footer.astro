---
import Logo from "@/components/Logo.astro";
import { CONTACT, SITE } from "@/lib/site";

const cols = [
  {
    title: "Producto",
    links: [
      { href: "#como-funciona", label: "Cómo funciona" },
      { href: "#liga", label: "Ligas" },
      { href: "#anti-trampas", label: "Retos" },
    ],
  },
  {
    title: "Descarga",
    links: [
      { href: "#descargar", label: "Descargar RivalFit" },
      { href: "#descargar", label: "Instalación" },
    ],
  },
] as const;
---

<footer class="border-t border-line bg-[#f7f5f0]">
  <div class="container-site py-14">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="#top" aria-label="RivalFit — inicio">
          <Logo />
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-bone-muted">
          {SITE.tagline} Cada sesión cuenta, cada rep se valida y la competencia se mantiene justa.
        </p>
        <p class="mt-6 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-bone-faint">
          {SITE.url}
        </p>
      </div>

      {
        cols.map((col) => (
          <nav aria-label={col.title}>
            <p class="mb-4 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-bone-faint">
              {col.title}
            </p>
            <ul class="space-y-2.5">
              {
                col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-bone-muted transition-colors hover:text-volt-ink">
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 sm:flex-row sm:items-center">
      <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-bone-faint">
        © 2026 {SITE.name}
      </p>
      <a
        href={CONTACT.emailHref}
        class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-bone-muted transition-colors hover:text-volt-ink"
      >
        {CONTACT.email}
      </a>
    </div>
  </div>
</footer>