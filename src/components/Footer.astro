---
import Logo from "@/components/Logo.astro";
import { CONTACT, SITE } from "@/lib/site";

const links = [
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#anti-trampas", label: "Anti-trampas" },
  { href: "#descargar", label: "Descargar RivalFit" },
  { href: "#descargar", label: "Instalación" },
] as const;
---

<footer class="border-t border-line bg-[#f7f5f0] dark:bg-[#171812]">
  <div class="container-site py-10 sm:py-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <a href="#top" class="shrink-0" aria-label="RivalFit — inicio">
        <Logo />
      </a>

      <p class="hidden max-w-sm text-sm leading-relaxed text-bone-muted lg:block">
        Cada sesión suma y la competencia se mantiene real.
      </p>

      <nav aria-label="Navegación" class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-bone-muted transition-colors hover:text-volt-ink dark:hover:text-volt"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-2 border-t border-line pt-5 sm:flex-row sm:items-center">
      <p class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-bone-muted">
        © 2026 {SITE.name} · {SITE.url}
      </p>
      <a
        href={CONTACT.emailHref}
        class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-bone-muted transition-colors hover:text-volt-ink dark:hover:text-volt"
      >
        {CONTACT.email}
      </a>
    </div>
  </div>
</footer>