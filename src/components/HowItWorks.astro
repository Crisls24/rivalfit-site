<!-- ═══ RIVALFIT: CÓMO FUNCIONA ═══ -->
<section id="como-funciona" class="scroll-mt-[5.5rem] border-t border-line bg-[#f7f5f0] dark:bg-[#171812]">
  <div
    class="mx-auto flex w-full max-w-[1024px] flex-col px-6 pt-12 pb-8 sm:px-8 sm:pt-16 sm:pb-10 lg:min-h-[calc(100vh-4rem)] lg:justify-between"
  >
    <!-- Encabezado -->
    <div class="mb-6" data-reveal>
      <h2 class="font-display font-bold leading-[1.05] tracking-tight text-[clamp(1.9rem,3vw,2.5rem)]">
        Entrena con propósito
      </h2>
      <p class="mt-2 text-lg leading-snug text-[#4B5563] dark:text-bone-muted">
        No entrenas solo para terminar.<br />
        Entrenas para avanzar.
      </p>
    </div>

    <!-- Stepper · 3 pasos equilibrados -->
    <div class="grid gap-6 md:grid-cols-3" data-reveal style="--reveal-delay:90ms">
      <!-- 01 · ENTRENA -->
      <article
        data-spotlight
        class="group relative flex min-h-[380px] flex-col overflow-hidden rounded-[20px] border border-[#E5E7EB] bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_44px_rgba(17,19,17,0.10)] dark:border-[#2B2C25] dark:bg-card"
      >
        <span class="rf-spot" aria-hidden="true"></span>
        <header class="flex items-center gap-2.5">
          <span class="rounded-full bg-volt/15 px-2.5 py-1 font-sans text-[0.8rem] font-bold uppercase tracking-[0.1em] text-volt-ink dark:bg-volt">
            01 · Entrena
          </span>
        </header>

        <div class="mt-4 h-[190px] overflow-hidden rounded-xl bg-[#16161a]">
          <video
            class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.06]"
            src="/assets/videos/148202-793717935_medium.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Entrenamiento de RivalFit"
          ></video>
        </div>

        <p class="mt-auto pt-4 text-base font-medium leading-[1.5] text-bone-muted line-clamp-2">
          Completa tu entrenamiento diario y registra cada repetición.
        </p>
      </article>

      <!-- 02 · COMPITE -->
      <article
        data-spotlight
        data-draw
        class="group relative flex min-h-[380px] flex-col overflow-hidden rounded-[20px] border border-[#E5E7EB] bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_44px_rgba(17,19,17,0.10)] dark:border-[#2B2C25] dark:bg-card"
      >
        <span class="rf-spot" aria-hidden="true"></span>
        <header class="flex items-center gap-2.5">
          <span class="rounded-full bg-volt/15 px-2.5 py-1 font-sans text-[0.8rem] font-bold uppercase tracking-[0.1em] text-volt-ink dark:bg-volt">
            02 · Compite
          </span>
        </header>

        <div class="mt-4 h-[190px]">
          <div class="flex h-full flex-col rounded-2xl border border-[#E8E3D8] bg-[#FBF9F5] p-4 dark:border-[#2B2C25] dark:bg-[#171812]">
            <div class="flex items-center gap-3">
              <div class="flex -space-x-2" aria-hidden="true">
                <span class="h-10 w-10 rounded-full border-2 border-[#FBF9F5] bg-[#e6e0d3] dark:border-[#171812] dark:bg-[#33342c]"></span>
                <span class="h-10 w-10 rounded-full border-2 border-[#FBF9F5] bg-[#ddd6c5] dark:border-[#171812] dark:bg-[#3a3b33]"></span>
                <span class="h-10 w-10 rounded-full border-2 border-[#FBF9F5] bg-[#d2cab6] dark:border-[#171812] dark:bg-[#42433a]"></span>
                <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-[#FBF9F5] bg-volt font-sans text-xl font-bold text-volt-ink dark:border-[#171812]">
                  +
                </span>
              </div>
              <span class="ml-1 flex-none leading-none whitespace-nowrap rounded-full bg-volt/15 px-2.5 py-1 font-mono text-[0.8rem] font-bold uppercase tracking-[0.08em] text-volt-ink dark:bg-volt">
                Tu Clan · #2
              </span>
            </div>

            <div class="mt-auto">
              <div class="mb-2 flex items-center justify-between font-mono text-[0.8rem] uppercase tracking-[0.08em] text-bone-faint">
                <span>Semana</span>
                <span>3 / 4</span>
              </div>
              <div class="flex h-1.5 w-full gap-1">
                <span class="flex-1 rounded-full bg-[#E8E3D8] dark:bg-[#2C2D26]"></span>
                <span class="flex-1 rounded-full bg-[#E8E3D8] dark:bg-[#2C2D26]"></span>
                <span class="rf-bar-fill flex-1 rounded-full bg-volt"></span>
                <span class="flex-1 rounded-full bg-[#E8E3D8] dark:bg-[#2C2D26]"></span>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-auto pt-4 text-base font-medium leading-[1.5] text-bone-muted line-clamp-2">
          Crea tu liga, invita a tus amigos y compitan semana a semana.
        </p>
      </article>

      <!-- 03 · AVANZA -->
      <article
        data-spotlight
        data-draw
        class="group relative flex min-h-[380px] flex-col overflow-hidden rounded-[20px] border border-[#E5E7EB] bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.04)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_44px_rgba(17,19,17,0.10)] dark:border-[#2B2C25] dark:bg-card"
      >
        <span class="rf-spot" aria-hidden="true"></span>
        <header class="flex items-center gap-2.5">
          <span class="rounded-full bg-volt/15 px-2.5 py-1 font-sans text-[0.8rem] font-bold uppercase tracking-[0.1em] text-volt-ink dark:bg-volt">
            03 · Avanza
          </span>
        </header>

        <div class="mt-4 h-[190px]">
          <div class="flex h-full flex-col rounded-2xl border border-[#E8E3D8] bg-[#FBF9F5] p-4 dark:border-[#2B2C25] dark:bg-[#171812]">
            <div class="flex items-center">
              <span class="whitespace-nowrap rounded-full bg-volt/20 px-3 py-1 font-mono text-[0.8rem] font-bold uppercase tracking-[0.08em] text-volt-ink shadow-[0_0_12px_rgba(164,238,0,0.35)] dark:bg-volt">
                Nivel Leyenda
              </span>
            </div>

            <div class="mt-3">
              <svg viewBox="0 0 200 84" fill="none" preserveAspectRatio="xMidYMid meet" class="h-auto w-full [aspect-ratio:200/84]" aria-hidden="true">
                <path class="rf-area" d="M0 70 L40 62 L80 64 L120 48 L160 34 L190 14 L190 70 Z" fill="#A4EE00" fill-opacity="0.14" />
                <path class="rf-chart-path" pathLength={1} d="M0 70 L40 62 L80 64 L120 48 L160 34 L190 14" stroke="#8B8578" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="0" cy="70" r="4" fill="#D9D2C2" />
                <circle cx="190" cy="14" r="8" fill="#A4EE00" class="animate-pulse [filter:drop-shadow(0_0_12px_rgba(164,238,0,0.9))]" />
                <circle cx="190" cy="14" r="14" stroke="#A4EE00" stroke-opacity="0.4" stroke-width="2" />
              </svg>
            </div>
          </div>
        </div>

        <p class="mt-auto pt-4 text-base font-medium leading-[1.5] text-bone-muted line-clamp-2">
          Cada sesión suma experiencia para subir tus músculos de categoría.
        </p>
      </article>
    </div>
  </div>
</section>