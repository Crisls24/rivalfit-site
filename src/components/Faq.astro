---
const faqs = [
  {
    q: "¿Mi cámara se usa para contar repeticiones?",
    a: "Sí, pero solo en tu teléfono. RivalFit usa la cámara para reconocer el ejercicio y validar cada repetición. No necesitas subir tus videos para competir.",
  },
  {
    q: "¿Qué es una liga y cómo me uno?",
    a: "Una liga es una mini competencia entre amigos. Tú creas la liga, compartes el código o el enlace y cada semana se ordenan según quién entrenó más y mejor.",
  },
  {
    q: "¿Cómo instalo la beta?",
    a: "Descarga la APK desde este sitio, acepta instalar apps de fuentes desconocidas en Android y abre RivalFit. Enseguida puedes crear tu liga y empezar.",
  },
  {
    q: "¿RivalFit es gratis?",
    a: "La beta cerrada es gratis. Cuando salga la versión oficial, definiremos el precio según el plan y la comunidad que use la app.",
  },
  {
    q: "¿Qué ejercicios puedo contar?",
    a: "La beta está pensada para ejercicios con movimiento claro, como sentadillas, lagartijas, abdominales y dips. También podemos ampliar opciones con el tiempo.",
  },
  {
    q: "¿Cuándo llega a iOS?",
    a: "Por ahora el foco está en Android para que la beta pueda llegar bien y competir sin fricción. Cuando estemos listos, te lo contaremos.",
  },
] as const;
---

<!-- ═══ FAQ ═══ -->
<section id="faq" class="border-t border-line bg-background">
  <div class="container-site pt-12 pb-16 sm:pt-14 sm:pb-20">
    <div class="max-w-2xl" data-reveal>
      <p class="mb-4 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-bone-faint">
        Preguntas frecuentes
      </p>
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
        Duda resuelta antes de empezar.
      </h2>
    </div>

    <div
      class="mt-10 max-w-4xl border-t border-line md:grid md:grid-cols-2 md:gap-x-12"
      data-reveal
      style="--reveal-delay:100ms"
    >
      {
        faqs.map((faq) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-4 pr-2 text-left">
              <span class="font-semibold leading-snug text-bone transition-colors group-open:text-volt-ink">
                {faq.q}
              </span>
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line bg-[#faf9f5] font-mono text-sm text-bone-faint transition-transform group-open:rotate-45 dark:bg-[#1B1C17]"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="rf-answer">
              <p class="pb-5 pr-8 text-sm leading-relaxed text-bone-muted">{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>